# Copy to .env (never commit .env). Every variable is optional in development.

# --- required in production -------------------------------------------------
# At least 32 random characters; signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# First start only (when the database has no users): password of the first administrator (min 8 chars).
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# --- database ---------------------------------------------------------------
# PostgreSQL connection string (Neon or any managed Postgres). When empty, an embedded database is stored in DATA_DIR
# (fine for local use and a single-instance server; NOT for serverless or multiple instances).
DATABASE_URL=
# DATA_DIR=./data/pglite

# --- analysis engine --------------------------------------------------------
# Python 3.10+ interpreter used for matching/analytics (default: python3, "python" on Windows).
# PYTHON_BIN=python3
# ENGINE_TIMEOUT_MS=30000

# --- demo data --------------------------------------------------------------
# Development default: true (creates a synthetic DEMO study and demo accounts, password "demo-1234" unless SEED_PASSWORD is set).
# Production default: false. If you enable it in production you MUST set SEED_PASSWORD.
# SEED_DEMO=false
# SEED_PASSWORD=

# --- misc -------------------------------------------------------------------
# PORT=3000
# SESSION_HOURS=12
# TRUST_PROXY=true   # default true in production (behind a hosting proxy), needed for secure cookies and rate limiting
